# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Whop (payments)
WHOP_API_KEY=your_whop_api_key
WHOP_WEBHOOK_SECRET=your_whop_webhook_secret

# Resend (transactional email)
RESEND_API_KEY=re_...
EMAIL_FROM=orders@yourdomain.com
ADMIN_EMAIL=you@yourdomain.com

# Site
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# QuickBooks Online
QUICKBOOKS_CLIENT_ID=your_qb_client_id
QUICKBOOKS_CLIENT_SECRET=your_qb_client_secret
QUICKBOOKS_SANDBOX=false

# Shippo (shipping labels & rates)
SHIPPO_API_KEY=shippo_live_...
SHIPPO_FROM_NAME=Aurogen Labs
SHIPPO_FROM_STREET=123 Your Street
SHIPPO_FROM_CITY=Your City
SHIPPO_FROM_STATE=FL
SHIPPO_FROM_ZIP=00000

# TaxJar (US sales tax)
TAXJAR_API_KEY=your_taxjar_api_key

# Klaviyo (email marketing)
KLAVIYO_PRIVATE_KEY=pk_...

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Crisp (live chat)
NEXT_PUBLIC_CRISP_WEBSITE_ID=your_crisp_website_id
